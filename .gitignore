# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
.tox/
venv/
env/
.venv/
*.env

# Secrets – NEVER commit these
.env
*.key
*.pem
secrets.json

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata/

# Data – raw source files stay local; processed outputs are committed selectively
data/raw/*.csv
data/processed/*.csv
# Allow quality test data (small, controlled, no PII)
!data/quality_test/

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Power BI (binary – commit only when intentional)
*.pbix

# Excel (commit only the template; exclude large exports)
excel/exports/

# Logs
*.log
logs/
