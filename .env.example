# ─────────────────────────────────────────────────────────────────────────────
# RetainIQ AI – Environment Variable Template
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Optional: OpenAI API key for the AI insight generator (Module E)
# Leave blank to use the mock/fallback mode instead.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: SQL Server connection string (for sqlcmd or pyodbc)
# If SQL Server is not available locally, the SQL scripts remain valid
# deliverables and can be run in Azure Data Studio, SSMS, or a Docker container.
SQL_SERVER_CONNECTION=Server=localhost;Database=RetainIQ;Trusted_Connection=yes;

# Random seed used for all synthetic data generation.
# Change this only if you intentionally want a different dataset.
RANDOM_SEED=42
